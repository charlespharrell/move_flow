# --- MoveFlow API environment -------------------------------------------------
# Copy to .env and adjust. NEVER commit a real .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://moveflow:moveflow_dev_password@localhost:5432/moveflow?schema=public"

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-development-secret"
JWT_EXPIRES_IN="8h"

# API server
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API
CLIENT_URL="http://localhost:5173,http://127.0.0.1:5173"

# Optional: bcrypt cost factor (10 is a sane default)
BCRYPT_ROUNDS=10
